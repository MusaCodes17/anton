{
    email 41-glove.fruits@icloud.com
}

anton.musasouled.com {
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 7
        }
        format filter {
            wrap json
            fields {
                uri delete
                request>uri delete
                request>headers>Authorization delete
                request>headers>Cookie delete
            }
        }
    }

    # Backend paths — each has its own auth (session cookie, desktop bearer,
    # connector OAuth). Must reach the backend, NOT the static handler.
    @backend {
        path /api /api/* /mcp /mcp/* /authorize /token /revoke /oauth/login /.well-known/oauth-authorization-server /health
    }
    handle @backend {
        reverse_proxy localhost:8000 {
            flush_interval -1
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Everything else = the SPA. Public bundle (no secret in it); the RA2 login
    # view + httpOnly session cookie is the gate.
    handle {
        root * /var/www/anton
        try_files {path} /index.html
        file_server
    }

    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}