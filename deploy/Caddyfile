{
    email 41-glove.fruits@icloud.com
}

anton.musasouled.com {
    # compress responses (phone perf, 2026-10-10); SSE (text/event-stream) deliberately excluded so chat streams aren't buffered
    encode {
        zstd
        gzip
        match {
            header Content-Type text/html*
            header Content-Type text/css*
            header Content-Type text/plain*
            header Content-Type text/javascript*
            header Content-Type application/javascript*
            header Content-Type application/json*
            header Content-Type application/manifest+json*
            header Content-Type image/svg+xml*
        }
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 7
        }
        format filter {
            wrap json
            fields {
                uri delete
                request>uri delete
                request>headers>Authorization delete
                request>headers>Cookie delete
            }
        }
    }

    # Backend paths — each has its own auth (session cookie, desktop bearer,
    # connector OAuth). Must reach the backend, NOT the static handler.
    # /.well-known/oauth-protected-resource is public in the backend's PUBLIC_PATHS
    # (routers/oauth.py); it must be listed here or it falls through to the SPA.
    # R9.5 reconcile: check the production server's Caddyfile matches this matcher.
    @backend {
        path /api /api/* /mcp /mcp/* /authorize /token /revoke /oauth/login /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /health
    }
    handle @backend {
        reverse_proxy localhost:8000 {
            flush_interval -1
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Everything else = the SPA. Public bundle (no secret in it); the RA2 login
    # view + httpOnly session cookie is the gate.
    handle {
        root * /var/www/anton
        try_files {path} /index.html
        file_server
    }

    # RA2.2 PWA: the service worker script must always be revalidated so new
    # deploys propagate — Workbox/Vite revision the *precache*, but the SW
    # script (sw.js) and its registrar must never be served HTTP-cached stale.
    @sw path /sw.js /registerSW.js /workbox-*.js
    header @sw Cache-Control "no-cache"

    # Ensure the web manifest carries the correct content-type for install.
    @manifest path /manifest.webmanifest
    header @manifest Content-Type "application/manifest+json"

    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # R9.5 — the deals page link is shared with the run club; CSP ships report-only
    # first and switches to enforcing (rename the header to Content-Security-Policy)
    # after a clean week; noindex because the page is for a small group, not search engines.
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        X-Robots-Tag "noindex, nofollow"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' https: data:; font-src https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self'; frame-ancestors 'none'"
    }
}